"""Shared test fixtures: an isolated ledger, a clean board, a test client."""

from __future__ import annotations

import os
import tempfile

_TMP_DIR = tempfile.mkdtemp(prefix="paygate-tests-")
os.environ["PAYGATE_DB"] = os.path.join(_TMP_DIR, "paygate.sqlite")
os.environ["PAYGATE_LLM_MODE"] = "deterministic"
os.environ.pop("PAYGATE_GATEWAY", None)

import pytest  # noqa: E402
from fastapi.testclient import TestClient  # noqa: E402

from app.main import TRACE, STORE, app  # noqa: E402, F401


@pytest.fixture(autouse=True)
def _clean_state():
    STORE.reset()
    TRACE.clear()
    os.environ.pop("PAYGATE_GATEWAY", None)
    yield
    os.environ.pop("PAYGATE_GATEWAY", None)


@pytest.fixture()
def client():
    with TestClient(app) as test_client:
        yield test_client

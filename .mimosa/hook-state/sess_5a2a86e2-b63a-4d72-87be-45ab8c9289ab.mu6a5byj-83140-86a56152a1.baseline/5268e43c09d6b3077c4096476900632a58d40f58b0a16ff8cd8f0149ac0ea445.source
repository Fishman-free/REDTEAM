"""Payment planning for PayGate.

The plan is a pure function of the trusted authorization the platform attaches
to the task when it is created: exactly one payment, to the authorized
recipient, for the authorized amount, currency and purpose, under a request id
derived from the task id.

Nothing else takes part in the decision:

- The four external surfaces (merchant messages, invoices, webhooks, product
  pages) are outside the trust boundary. Their content is stored verbatim so a
  human can review it, but a claim made there -- "already settled", "order
  cancelled", "pay X to Y", "settle in USD" -- describes the writer's own
  systems, never the state of this ledger. Letting such a claim steer the plan
  lets one forged callback both stop a legitimate payment and redirect the
  money, so external text can neither add a payment, nor re-price one, nor
  suppress the authorized one.

- Model output is untrusted for the same reason: it reads the same external
  text and cannot grant authority, so the planner does not consult it.
  ``PAYGATE_LLM_MODE`` is still accepted as configuration, but no mode widens
  the plan beyond the trusted authorization.
"""

from __future__ import annotations

import os
from dataclasses import dataclass

from .policy import PolicyGuard
from .store import TaskRecord
from .surfaces import SurfaceBoard


@dataclass
class PlanItem:
    request_id: str
    order_id: str
    recipient: str
    amount_minor: int
    purpose: str
    currency: str = "CNY"
    source: str = "user"
    user_confirmed: bool = False


class PaymentDecisionAgent:
    """Produce the ordered payment plan for one task run."""

    def __init__(self, policy: PolicyGuard, mode: str | None = None) -> None:
        self.policy = policy
        self.mode = (mode or os.environ.get("PAYGATE_LLM_MODE") or "deterministic").strip().lower()

    # ------------------------------------------------------------- entrypoint

    def build_plan(self, task: TaskRecord, board: SurfaceBoard) -> tuple[list[PlanItem], str]:
        """Plan the authorized payment and nothing else.

        ``board`` is accepted so callers can hand the run's context in one
        place, but no surface is consulted: there is no external statement
        that can complete, alter or cancel a payment the platform authorized.
        """
        return [self._authorized_item(task)], "payment workflow completed"

    def _authorized_item(self, task: TaskRecord) -> PlanItem:
        authorization = task.authorization
        return PlanItem(
            request_id=f"{task.task_id}:purchase",
            order_id=authorization.order_id,
            recipient=authorization.recipient,
            amount_minor=authorization.exact_amount_minor,
            purpose="purchase",
            currency=authorization.currency,
            source="user",
            user_confirmed=True,
        )

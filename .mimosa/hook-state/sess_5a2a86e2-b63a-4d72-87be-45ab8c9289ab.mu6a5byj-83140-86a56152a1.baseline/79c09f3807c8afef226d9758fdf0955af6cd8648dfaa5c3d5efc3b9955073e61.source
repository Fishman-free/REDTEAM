"""Untrusted external input surfaces.

Four channels feed content into the gateway from the outside:

- ``merchant_message``: free-form messages from the merchant help desk
- ``invoice``: HTML billing e-mails
- ``webhook``: machine callbacks (reconciliation, payment providers, ...)
- ``product_page``: rendered product/order pages

All of this content is outside the trust boundary of the platform. It is stored
verbatim so it can be reviewed via ``GET /external/view/{surface}``, and it is
never parsed into payment decisions: no field of a callback payload, no hidden
form value, no prose sentence and no "already settled" / "order cancelled" /
"user confirmed" claim made on any of these channels can change what PayGate
pays. The decision module does not read these surfaces at all.
"""

from __future__ import annotations

import re
from typing import Any

from .store import Ledger

SURFACE_NAMES = ("merchant_message", "invoice", "webhook", "product_page")

_HTML_TAG = re.compile(r"<[^>]+>")


def visible_text(html: str) -> str:
    """Render the visible text of an HTML document.

    Markup-internal content -- comments and form fields the customer never sees
    -- is deliberately dropped rather than promoted into the decision context:
    content hidden from a human reader is exactly where an injected instruction
    hides, and giving it a machine-readable route into the gateway would hand
    it more authority than the visible page has.
    """
    return _HTML_TAG.sub(" ", html)


class SurfaceBoard:
    """Read/write access to the current content of the four external surfaces."""

    def __init__(self, store: Ledger) -> None:
        self._store = store

    def write(self, surface: str, order_id: str | None, content: str) -> None:
        if surface not in SURFACE_NAMES:
            raise ValueError(f"unknown surface: {surface}")
        self._store.set_surface(surface, order_id, content)

    def read(self, surface: str) -> dict[str, Any] | None:
        if surface not in SURFACE_NAMES:
            raise ValueError(f"unknown surface: {surface}")
        return self._store.get_surface(surface)

    def decision_text(self, surface: str) -> str:
        """Return the text of a surface as it may be shown to a human reader."""
        row = self._store.get_surface(surface)
        if row is None:
            return ""
        content = row["content"]
        if surface == "invoice":
            return visible_text(content)
        return content

FROM node:22-bookworm-slim

WORKDIR /app

COPY contracts/package.json contracts/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY contracts/ ./
RUN npx hardhat compile

COPY deploy/wait-for-rpc.mjs /app/wait-for-rpc.mjs
COPY deploy/deploy-contracts.sh /app/deploy-contracts.sh
RUN chmod +x /app/deploy-contracts.sh

ENTRYPOINT ["/bin/sh", "/app/deploy-contracts.sh"]

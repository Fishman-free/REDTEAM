# Put the real key in .env, which is ignored by Git. Never commit real credentials.
GLM_API_KEY=replace-locally
GLM_MODEL=glm-5.3
GLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4

# Payment planner only; attacker, defender, judge and experiment roles use glm-5.3.
# Start SSH forwarding with: python execution/scripts/studio_model.py start
SUT_MODEL=Qwen/Qwen3-4B-Instruct-2507
SUT_BASE_URL=http://127.0.0.1:18081/v1

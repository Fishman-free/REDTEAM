# Vite dev server proxies /api to http://127.0.0.1:8080.
# For a built static site set VITE_API_URL to the API origin.
VITE_API_URL=/api
# Dev-only bearer token. It is bundled into the frontend, so never use a
# production/operator token here.
VITE_API_TOKEN=replace-with-platform-api-token
VITE_RPC_URL=http://127.0.0.1:8546

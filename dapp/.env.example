# The browser always talks to the same origin via /api.
VITE_API_URL=/api
# Public RPC for the dApp. In production use an HTTPS RPC or a same-origin /rpc
# reverse proxy; the default is the local Anvil/Besu endpoint.
VITE_RPC_URL=http://127.0.0.1:8546
# Optional. If set, transaction/hash links open this explorer (no trailing slash).
# VITE_EXPLORER_URL=https://sepolia.basescan.org

# PLATFORM_API_TOKEN is intentionally NOT a VITE_* variable. The Vite dev proxy
# reads it from ../platform/.env.local and injects Authorization server-side.
# Production uses server.mjs with PLATFORM_API_TOKEN in the server environment.
